# =============================================================================
# Dido Store — Root Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# These variables are used by Docker Compose.

# --- Database ---
DB_DATABASE=dido_store
DB_USERNAME=dido_user
DB_PASSWORD=dido_secret_password
DB_ROOT_PASSWORD=root_secret_password
DB_PORT=3306

# --- Laravel ---
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_URL=http://localhost:8000
APP_DEBUG=false

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Ports ---
API_PORT=8000
FRONTEND_PORT=3000
PMA_PORT=8080
